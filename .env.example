#NODE_ENV="development"
NODE_ENV="production"
TELEGRAM_SESSION=
TELEGRAM_API_ID=123123
TELEGRAM_API_HASH="123123"
DISCORD_BOT_TOKEN="ads123"
CMC_API_KEY="123-123"
# Users allowed to run discordapp admin commands. Empty = nobody.
DISCORD_COMMAND_WHITELIST="123123"
# discordapp (docs/DISCORDAPP.md). Delivery works without it.
# DISCORD_APP_ENABLED="true"
# DISCORD_GUILD_IDS=""               # servers discordapp serves; empty = all the bot is in
# DISCORD_UPLOAD_LIMIT_MB="20"       # largest attachment Discord delivery sends
# DISCORD_EXPORT_TELEGRAM_CHAT=""    # Telegram chat id or @username that also gets /export-chats files; empty = disk only
# Optional since v4.15.0 — defaults are 5 and 50. An unset or invalid value
# now falls back with a [CONFIG] warning at startup instead of becoming NaN.
POLLING_INTERVAL_MIN="5"
POLLING_FETCH_LIMIT="50"
# Optional scheduler knobs. Defaults shown; unset is silent.
# POLLING_TICK_MS="30000"          # how often the scheduler checks what is due
# POLLING_MAX_PER_TICK="8"         # ceiling on channels polled in one tick
# POLLING_MAX_DRAIN_PAGES="5"      # catch-up pages per channel per tick

# ── TheFlow (Phase 0) ──────────────────────────────────────────────
# Optional. Defaults are applied in src/config/app.config.js.
# THEFLOW_MIN_TEXT_LENGTH="10"
# THEFLOW_REPOST_WINDOW_HOURS="24"

# ── TheFlow — LLM gateway (Phase 1) ────────────────────────────────
# Provider decision (ROADMAP 3.1): Gemini primary for text, vision and
# embeddings; OpenRouter as fallback for text ONLY. The enrichment worker
# starts only when the LLM_PRIMARY provider has a key.
LLM_PRIMARY="gemini"
LLM_FALLBACK="openrouter"
# LLM_TIER_UP=""                  # stronger model id for low-confidence re-runs
# LLM_TIER_UP_BELOW="0.5"
# ENRICH_WORKER_ENABLED="true"
# ENRICH_TICK_MS="30000"
# ENRICH_BATCH_SIZE="10"
# ENRICH_MAX_ATTEMPTS="3"

# Deduplication (ROADMAP 6). Starting thresholds, not constants: calibrate
# with `node src/cli.js flow dedup --pairs 30`.
# DEDUP_ENABLED="true"
# DEDUP_HIGH="0.9"                        # s >= HIGH: same event
# DEDUP_LOW="0.75"                        # s <= LOW: new event; between: gray zone
# DEDUP_TIER2_SAME_SOURCE="false"         # true: tier 2 also against the post's own source

# TheFlow health (ROADMAP 13.10). Alerts go to health_destinations in
# routing.json; without it, to the log only.
# FLOW_HEALTH_INTERVAL_MIN="10"
# FLOW_HEALTH_PENDING_MAX_AGE_MIN="120"   # old pending AND no progress this long = stalled
# FLOW_HEALTH_FAILURE_WINDOW_MIN="60"
# FLOW_HEALTH_FAILURE_MIN="5"             # at least this many failed in the window...
# FLOW_HEALTH_FAILURE_SHARE="0.5"         # ...and this share of everything that finished
# FLOW_HEALTH_INGEST_SILENT_HOURS="24"
# FLOW_HEALTH_REPEAT_HOURS="6"            # reminder while a problem lasts

# Gemini. Model ids verified with the live key (models.list) on 2026-09-13.
GEMINI_API_KEY=""
# gemini-3.5-flash-lite: free tier RPD 500 / RPM 15. NOT gemini-2.5-flash —
# that and every Flash 3.x model have RPD 20 on the free tier.
# GEMINI_COMPLETE_MODEL="gemini-3.5-flash-lite"
# GEMINI_VISION_MODEL=""                     # defaults to the complete model (shares its budget)
# GEMINI_EMBED_MODEL="gemini-embedding-2"    # NOT text-embedding-004 — shut down 2026-01-14
# GEMINI_EMBED_DIM="768"                     # pinned on purpose; the model default is 3072
# VISION_CACHE_TTL_HOURS="72"               # how long transcriptions are reused across reposts

# Limits are PER MODEL — each model is its own row in AI Studio
# (aistudio.google.com/rate-limit). Defaults are the free-tier values measured
# on 2026-09-13; a paid project has higher ones. Set these only if yours differ.
# GEMINI_RPD="500"                           # complete model (gemini-3.5-flash-lite)
# GEMINI_RPM="15"
# GEMINI_EMBED_RPD="1000"                    # embed model (gemini-embedding-2)
# GEMINI_EMBED_RPM="100"
# GEMINI_VISION_RPD=""                       # only if GEMINI_VISION_MODEL differs
# GEMINI_VISION_RPM=""
# GEMINI_QUOTA_TZ="America/Los_Angeles"      # Google resets RPD at Pacific midnight, not UTC

# OpenRouter — fallback for text enrichment only.
OPENROUTER_API_KEY=""
# Must support structured output (response_format: json_schema) — check the
# model page on openrouter.ai before choosing.
OPENROUTER_COMPLETE_MODEL=""
# Leave empty ON PURPOSE. OpenRouter does have /embeddings, but a vector from a
# second model lands in a space dedup never searches (ROADMAP 13.2), making the
# post invisible to it. A missing embedding is backfillable by the same model.
# OPENROUTER_EMBED_MODEL=""
# OPENROUTER_RPD="200"
# OPENROUTER_RPM="20"
# OPENROUTER_QUOTA_TZ="UTC"                  # unverified — set if your account resets elsewhere