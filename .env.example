# Inemuri — every environment variable the service reads (src/config/app.config.js).
# Every line is active and set to the built-in default, so a copy of this file
# runs as the code would without it; change what your deployment needs. An empty
# value ("") means "not set" and takes the default. An invalid number falls back
# to its default with a [CONFIG] warning at startup. Switches take true/false (also 1/0, yes/no,
# on/off, any case); anything else warns and keeps the default.

# ── Runtime ─────────────────────────────────────────────────────────
# Always production: under "development" the database is recreated (sync force) and sources are lost.
NODE_ENV="production"
# Lowest level that reaches the log: debug | info | warning | error.
LOG_LEVEL="debug"
# Database file; npm test points this at a throwaway copy. Default: database/pot.sqlite.
SQLITE_STORAGE=""

# ── Telegram (user account, MTProto) ────────────────────────────────
TELEGRAM_SESSION=
TELEGRAM_API_ID=123123
TELEGRAM_API_HASH="123123"
# Telegram Premium on the sending account: media captions up to 4096 instead of 1024.
TELEGRAM_PREMIUM="false"
TELEGRAM_CONNECTION_RETRIES="5"

# Polling. Defaults are 5 and 50; unset or invalid falls back with a warning.
POLLING_INTERVAL_MIN="5"
POLLING_FETCH_LIMIT="50"
POLLING_TICK_MS="30000"          # how often the scheduler checks what is due
POLLING_MAX_PER_TICK="8"         # ceiling on channels polled in one tick
POLLING_MAX_DRAIN_PAGES="5"      # catch-up pages per channel per tick

# ── Discord ─────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN="ads123"
# Users allowed to run discordapp admin commands. Empty = nobody.
DISCORD_COMMAND_WHITELIST="123123"
# discordapp (docs/DISCORDAPP.md). Delivery works without it.
DISCORD_APP_ENABLED="true"
DISCORD_GUILD_IDS=""               # servers discordapp serves; empty = all the bot is in
DISCORD_UPLOAD_LIMIT_MB="20"       # largest attachment Discord delivery sends
DISCORD_EXPORT_TELEGRAM_CHAT=""    # Telegram chat id or @username that also gets /export-chats files; empty = disk only

# ── Daily crypto report (cron job; destinations in cronjob.config.json) ──
CMC_API_KEY="123-123"
DAILY_REPORT_ENABLED="true"
DAILY_REPORT_CRON="5 0 * * *"      # server time

# ── Feed sources: RSS/Atom, news sitemaps, WordPress, Reddit ────────
FEED_POLL_INTERVAL_MIN="15"        # per source, unless poll_interval_min is set
FEED_USER_AGENT=""                 # default: Inemuri/<version> (TheFlow feed reader; +repo URL)
FEED_TIMEOUT_MS="15000"            # one feed request (and the Reddit OAuth token)
# Reddit refuses many unauthenticated clients (403). A "script" app at
# reddit.com/prefs/apps gives app-only OAuth:
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ── TheFlow — ingest ────────────────────────────────────────────────
THEFLOW_MIN_TEXT_LENGTH="10"       # shorter after replacements = skipped_empty
THEFLOW_REPOST_WINDOW_HOURS="24"   # same text from the same source = skipped_repost

# ── TheFlow — LLM gateway (docs/theflow/LLM_GATEWAY.md) ─────────────
# Gemini primary for text, vision and embeddings; OpenRouter as fallback for
# text ONLY. The enrich worker starts only when LLM_PRIMARY has a key.
LLM_PRIMARY="gemini"
LLM_FALLBACK="openrouter"
LLM_TIER_UP=""                     # stronger model id for low-confidence re-runs
LLM_TIER_UP_BELOW="0.5"
LLM_MAX_CONCURRENCY="2"            # provider calls in flight
LLM_TIMEOUT_MS="30000"             # one provider call
ENRICH_WORKER_ENABLED="true"
ENRICH_TICK_MS="30000"
ENRICH_BATCH_SIZE="10"
ENRICH_MAX_ATTEMPTS="3"

# Gemini. Model ids verified with the live key (models.list) on 2026-09-13.
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# gemini-3.5-flash-lite: free tier RPD 500 / RPM 15. NOT gemini-2.5-flash —
# that and every Flash 3.x model have RPD 20 on the free tier.
GEMINI_COMPLETE_MODEL="gemini-3.5-flash-lite"
GEMINI_VISION_MODEL=""                     # defaults to the complete model (shares its budget)
GEMINI_EMBED_MODEL="gemini-embedding-2"    # NOT text-embedding-004 — shut down 2026-01-14
GEMINI_EMBED_DIM="768"                     # pinned on purpose; the model default is 3072
# Limits are PER MODEL — each model is its own row in AI Studio
# (aistudio.google.com/rate-limit). Defaults are the free-tier values measured
# on 2026-09-13; a paid project has higher ones. Set these only if yours differ.
GEMINI_RPD="500"                           # complete model (gemini-3.5-flash-lite)
GEMINI_RPM="15"
GEMINI_EMBED_RPD="1000"                    # embed model (gemini-embedding-2)
GEMINI_EMBED_RPM="100"
GEMINI_VISION_RPD=""                       # only if GEMINI_VISION_MODEL differs
GEMINI_VISION_RPM=""
GEMINI_QUOTA_TZ="America/Los_Angeles"      # Google resets RPD at Pacific midnight, not UTC

# OpenRouter — fallback for text enrichment only.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Must support structured output (response_format: json_schema) — check the
# model page on openrouter.ai before choosing.
OPENROUTER_COMPLETE_MODEL=""
OPENROUTER_VISION_MODEL=""
# Leave empty ON PURPOSE. OpenRouter does have /embeddings, but a vector from a
# second model lands in a space dedup never searches (ROADMAP 13.2), making the
# post invisible to it. A missing embedding is backfillable by the same model.
OPENROUTER_EMBED_MODEL=""
OPENROUTER_EMBED_DIM=""
OPENROUTER_RPD="200"
OPENROUTER_RPM="20"
OPENROUTER_QUOTA_TZ="UTC"                  # unverified — set if your account resets elsewhere

# ── TheFlow — vision (docs/theflow/VISION.md) ───────────────────────
VISION_CACHE_TTL_HOURS="72"        # how long transcriptions are reused across reposts
VISION_MAX_DOCUMENT_MB="20"        # largest image document downloaded for transcription
VISION_MAX_SIDE="1024"             # longer side after downscaling, before sending
MAINTENANCE_SWEEP_HOURS="6"        # how often vision_cache and discovered_items are swept

# ── TheFlow — deduplication (docs/theflow/DEDUPLICATION.md) ─────────
# Starting thresholds, not constants: calibrate with `node src/cli.js flow dedup --pairs 30`.
DEDUP_ENABLED="true"
DEDUP_HIGH="0.9"                   # s >= HIGH: same event
DEDUP_LOW="0.75"                   # s <= LOW: new event; between: gray zone
DEDUP_TIER2_SAME_SOURCE="false"    # true: tier 2 also against the post's own source

# ── TheFlow — delivery (docs/theflow/DELIVERY.md) ───────────────────
# OFF until routing.json points at real channels; check `node src/cli.js flow preview` first.
FLOW_DELIVERY_ENABLED="false"
FLOW_DELIVERY_MAX_AGE_HOURS="24"   # older posts are never sent (history)
FLOW_DELIVERY_TICK_MS="15000"
FLOW_DELIVERY_MAX_APPENDS="3"      # additions edited into a sent message; corrections are never capped

# ── TheFlow — feedback, digest, search ──────────────────────────────
FLOW_FEWSHOT_ENABLED="true"        # flow review labels become enrich examples
FLOW_FEWSHOT_GOOD="4"
FLOW_FEWSHOT_WRONG="3"
FLOW_DIGEST_CRON="0 9 * * *"       # server time; needs digest_destinations in routing.json
FLOW_DIGEST_HOURS="24"
FLOW_DIGEST_PER_TOPIC="5"
FLOW_SEARCH_SEMANTIC_MAX_ROWS="20000"  # most recent vectors a semantic search compares

# ── TheFlow — headline triage (docs/theflow/NEWS_INTAKE.md) ─────────
# The reader profile is src/config/triage.json (git-ignored; copy triage.sample.json).
FLOW_TRIAGE_BATCH="50"             # headlines per model call
FLOW_TRIAGE_MAX_WAIT_MIN="20"      # an incomplete batch waits this long — saves daily quota
FLOW_TRIAGE_SAMPLE="0.05"          # share of model rejects flagged for `flow triage review`
FLOW_TRIAGE_RETENTION_DAYS="14"    # discovered_items are swept after this

# ── TheFlow — storage and health ────────────────────────────────────
# Nothing is pruned; past this point, review (ROADMAP 13.9).
FLOW_STORAGE_REVIEW_ROWS="500000"
FLOW_STORAGE_REVIEW_GB="2"
# Alerts go to health_destinations in routing.json; without it, to the log only.
FLOW_HEALTH_INTERVAL_MIN="10"
FLOW_HEALTH_PENDING_MAX_AGE_MIN="120"   # old pending AND no progress this long = stalled
FLOW_HEALTH_FAILURE_WINDOW_MIN="60"
FLOW_HEALTH_FAILURE_MIN="5"             # at least this many failed in the window...
FLOW_HEALTH_FAILURE_SHARE="0.5"         # ...and this share of everything that finished
FLOW_HEALTH_INGEST_SILENT_HOURS="24"
FLOW_HEALTH_REPEAT_HOURS="6"            # reminder while a problem lasts

# ── Status board (status_destinations in routing.json) ──────────────
STATUS_INTERVAL_MIN="60"
STATUS_SOURCE_SILENT_HOURS="72"
STATUS_CHANNEL_SILENT_HOURS="168"
STATUS_ACTIVITY_THROTTLE_MIN="5"   # last_seen_at written at most this often per source
STATUS_MAX_LINES="25"              # lines per section, then "…and N more"
